#!/usr/bin/env bash
# conch-bridge — server-side CLI that lets a Claude / Codex / Gemini
# session running on this server reach the user's phone (via the live
# Conch SSH connection) and ask it to do things.
#
# Why this exists: the AI agent runs on this server, the data the agent
# wants (logs, shell output, diagnostics) lives on the phone, and the
# phone can't accept inbound connections (NAT, mobile networks). So we
# can't push from server to phone. Instead, the Conch app polls a known
# directory tree on this server every ~2s and fulfils any requests it
# finds. This script is the producer side of that protocol.
#
# Installed ONLY when the user explicitly taps "Connect phone to server" in a
# chat (never auto-pushed to every server). Lives at ~/.local/bin/conch-bridge.
#
# Usage:
#   conch-bridge logs [--filter GLOB] [--level V|D|I|W|E] [--lines N] [--since ISO]
#   conch-bridge logs --tier adb                 # force system-wide (whole device)
#   conch-bridge logs --tier own                 # force own-uid only
#   conch-bridge shell 'pm list packages'        # run a command at shell uid
#   conch-bridge shell 'dumpsys battery'         # adb-shell-equivalent
#   conch-bridge ping                            # connectivity check
#   conch-bridge screenshot                      # request a screen capture
#   conch-bridge audio [--seconds N] [--out FILE]  # record the phone mic (N<=300, default 10)
#                                                # writes an .m4a and prints its path
#                                                # OFF by default: the user must enable it in
#                                                # Conch -> Settings -> Security
#
# Environment:
#   CONCH_BRIDGE_DIR        Default ~/.conch-bridge. Override for testing.
#   CONCH_BRIDGE_TIMEOUT_S  Seconds to wait for phone to respond (default 30).

set -euo pipefail

# A real COMMAND failure (a command returning non-zero under set -e) lands here
# and says plainly: this is a bug in THIS wrapper, not the phone, plus how to
# debug. KNOWN LIMIT (learned the hard way): a `set -u` unbound-variable or a
# syntax error does NOT fire ERR — it aborts during expansion and only prints to
# stderr. So the durable protections are the nounset-safe guards below + NEVER
# masking stderr with `2>/dev/null`; this trap is only a net for the
# command-failure class, not the bug that once hid for hours.
trap 'rc=$?; echo "conch-bridge: internal error (exit $rc) near line $LINENO — bug in the wrapper script, not your phone. Re-run \`bash -x $0 ...\` to find the failing line." >&2' ERR

# Bump whenever this script changes — the app compares installed-vs-bundled on
# the server page and offers Update.
CONCH_BRIDGE_VERSION="9"

BRIDGE_DIR=${CONCH_BRIDGE_DIR:-$HOME/.conch-bridge}
TIMEOUT_S=${CONCH_BRIDGE_TIMEOUT_S:-30}
# A recording cannot finish before it finishes. `audio --seconds N` documents N
# up to 300, but the fixed 30 s deadline meant anything past ~25 s was reported
# as "phone didn't respond" while the phone was still recording — and the reply
# then landed in an outbox nobody was reading. The deadline follows the request.
case " $* " in
  *" audio "*)
    _secs=30
    _next=0
    for _a in "$@"; do
      [ "$_next" = 1 ] && { _secs=$_a; break; }
      [ "$_a" = "--seconds" ] && _next=1
    done
    case "$_secs" in
      ''|*[!0-9]*) _secs=30 ;;
    esac
    TIMEOUT_S=$(( _secs + 20 ))
    ;;
esac
INBOX="$BRIDGE_DIR/inbox"
OUTBOX="$BRIDGE_DIR/outbox"

mkdir -p "$INBOX" "$OUTBOX"
chmod 700 "$BRIDGE_DIR" "$INBOX" "$OUTBOX"

usage() {
  sed -n '2,30p' "$0"
  exit 1
}

[ $# -ge 1 ] || usage
CMD=$1; shift

# `shell` takes the REST of the line as the command (it can contain
# dashes, pipes, quotes), so capture it now and clear $@ so the flag
# parser below is a no-op for this subcommand.
SHELL_CMD=""
if [ "$CMD" = "shell" ]; then
  SHELL_CMD="$*"
  set --
fi

# `version` is local — report the script version, no phone round-trip.
if [ "$CMD" = "version" ]; then echo "$CONCH_BRIDGE_VERSION"; exit 0; fi

# UUID. Falls back to /proc/sys/kernel/random/uuid; last resort is a
# date+pid mash.
gen_id() {
  if command -v uuidgen >/dev/null 2>&1; then uuidgen
  elif [ -r /proc/sys/kernel/random/uuid ]; then cat /proc/sys/kernel/random/uuid
  else printf "%s-%s" "$(date +%s%N)" "$$"
  fi
}

# Args parsing — flags can be `--key value` or `--key=value`.
declare -A ARGS
while [ $# -gt 0 ]; do
  case "$1" in
    --*=*)
      key=${1%%=*}; key=${key#--}
      val=${1#*=}
      ARGS[$key]=$val
      shift
      ;;
    --*)
      key=${1#--}
      ARGS[$key]=${2:-}
      shift 2
      ;;
    *)
      echo "conch-bridge: unexpected argument: $1" >&2
      usage
      ;;
  esac
done

ID=$(gen_id)
REQ="$INBOX/$ID.req.json"

build_req_logs() {
  cat <<EOF
{
  "id": "$ID",
  "command": "logs",
  "args": {
    "filter": $(jq_str "${ARGS[filter]:-}"),
    "level": $(jq_str "${ARGS[level]:-Verbose}"),
    "lines": ${ARGS[lines]:-2000},
    "since": $(jq_str "${ARGS[since]:-}"),
    "tier": $(jq_str "${ARGS[tier]:-}")
  },
  "ts": $(date +%s%3N)
}
EOF
}

build_req_ping() {
  cat <<EOF
{ "id": "$ID", "command": "ping", "ts": $(date +%s%3N) }
EOF
}

build_req_screenshot() {
  cat <<EOF
{
  "id": "$ID",
  "command": "screenshot",
  "args": { "region": $(jq_str "${ARGS[region]:-full}") },
  "ts": $(date +%s%3N)
}
EOF
}

build_req_audio() {
  cat <<EOF
{ "id": "$ID", "command": "audio", "args": { "seconds": ${ARGS[seconds]:-10} }, "ts": $(date +%s%3N) }
EOF
}

build_req_shell() {
  cat <<EOF
{ "id": "$ID", "command": "shell", "args": { "command": $(jq_str "$SHELL_CMD") }, "ts": $(date +%s%3N) }
EOF
}

# Quote a string as a JSON value, or `null` if it's empty.
#
# NO python3, NO node, NO jq. This script runs wherever the agent runs, and
# that includes the Linux INSIDE the phone - an Alpine rootfs with neither
# interpreter installed, where `python3: command not found` killed every single
# command at exit 127 while the phone itself was answering perfectly (owner,
# 2026-09-03: a ping that should be ping-pong and nothing else). awk is in
# busybox, toybox and coreutils alike; a wrapper that needs a language runtime
# to quote a string does not deserve to be the thing standing between an agent
# and a phone.
jq_str() {
  if [ -z "${1:-}" ]; then echo null; return; fi
  # sed does the two literal replacements - its replacement rules are the
  # same everywhere - and awk only JOINS lines, so nothing here depends on
  # how a given awk build reads a backslash inside a gsub replacement.
  printf '%s' "$1" \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' \
    | awk 'BEGIN { ORS = ""; print "\"" } { if (NR > 1) print "\\n"; print } END { print "\"" }'
}

case "$CMD" in
  logs)        build_req_logs       > "$REQ" ;;
  ping)        build_req_ping       > "$REQ" ;;
  screenshot)  build_req_screenshot > "$REQ" ;;
  audio)       build_req_audio      > "$REQ" ;;
  shell)
    [ -n "$SHELL_CMD" ] || { echo "conch-bridge: shell needs a command, e.g. conch-bridge shell 'pm list packages'" >&2; exit 1; }
    build_req_shell > "$REQ" ;;
  *)
    echo "conch-bridge: unknown subcommand: $CMD" >&2
    usage
    ;;
esac

# SEC-4: append-only audit trail. The bridge is an UNAUTHENTICATED channel —
# anything that can run this script as $USER can drive the phone — so record
# every request (when / who / what) to a log. It's append-only: a caller can't
# quietly rewrite history without leaving a gap in the id sequence, and the
# phone-side "Run shell from server" kill-switch is the matching control. Strict
# best-effort: wrapped so a failed log write never fails the request (set -e).
# Run in a SUBSHELL with `|| true` so a best-effort audit-write failure can
# never fail the real request — but do NOT add `2>/dev/null`: masking stderr
# here is exactly what hid a fatal `ARGS: unbound variable` for hours. The
# array-emptiness test uses the nounset-safe `${ARGS[*]+x}` form, because under
# `set -u` a bare `${#ARGS[@]}` on an empty associative array aborts the shell
# during expansion (so `|| true` alone wouldn't catch it — the subshell is what
# contains it).
(
  AUDIT="$BRIDGE_DIR/audit.log"
  detail="$SHELL_CMD"
  if [ -z "$detail" ] && [ "${ARGS[*]+x}" = x ]; then
    for k in "${!ARGS[@]}"; do detail="$detail $k=${ARGS[$k]}"; done
  fi
  printf '%s\t%s\t%s@%s\t%s\t%s\n' \
    "$(date +%Y-%m-%dT%H:%M:%S%z)" "$ID" \
    "$(id -un 2>/dev/null || echo '?')" "$(hostname 2>/dev/null || echo '?')" \
    "$CMD" "$detail" >> "$AUDIT"
  chmod 600 "$AUDIT"
) || true

# Wait for a NON-EMPTY response (`-s`, not `-f`): the app writes the reply via temp-file + atomic rename, and `-s` also guards against ever catching a 0-byte file mid-write (that race used to make json.load die "Expecting value: line 1 column 1"). Phone polls inbox every ~2s.
RES="$OUTBOX/$ID.res.json"
# The same answer in a form a shell can read with no parser: `key=value`, one
# per line, values base64. Written and renamed BEFORE res.json, so the file the
# loop below waits on is still the completion marker.
KV="$OUTBOX/$ID.res.kv"
DEADLINE=$(( $(date +%s) + TIMEOUT_S ))
while [ ! -s "$RES" ]; do
  if [ "$(date +%s)" -ge "$DEADLINE" ]; then
    echo "conch-bridge: phone didn't respond in ${TIMEOUT_S}s." >&2
    echo "  - Make sure Conch is running on the phone and connected to this server." >&2
    echo "  - Conch answers with the screen off too (a little slower), but not while the app is closed." >&2
    rm -f "$REQ"
    exit 2
  fi
  sleep 0.5
done

# Read the response. Nothing is parsed: the phone writes every field the shell
# needs into `$KV` as `key=base64`, because JSON in a shell script is either an
# interpreter dependency (the bug this replaced) or a hand-rolled parser that
# will one day meet a quote it does not expect. `res.json` stays untouched for
# anything else that reads the outbox.
if [ ! -s "$KV" ]; then
  echo "conch-bridge: the Conch app on the phone is older than this CLI (no .res.kv)." >&2
  echo "  - Open the server page in Conch and press Update on the phone bridge." >&2
  rm -f "$RES"
  exit 4
fi
kv_get() { sed -n "s/^$1=//p" "$KV" | head -1; }
kv_txt() { v=$(kv_get "$1"); [ -z "$v" ] && return 0; printf '%s' "$v" | base64 -d; }
OK=$(kv_get ok)
ERR=$(kv_txt err)
META=$(kv_txt meta)
HAS_DATA=$(kv_get data)

if [ "$OK" != "1" ]; then
  echo "conch-bridge: phone reported error: $ERR" >&2
  rm -f "$RES"
  exit 3
fi

if [ "$HAS_DATA" = "1" ]; then
  # SECURITY: the response carries a data_path, but we NEVER trust it as a
  # filesystem path. A compromised phone / MITM on the channel could return
  # "data_path":"~/.ssh/id_ed25519" (or any user-readable file) and this
  # branch would cat it to the agent AND delete it — a read+DELETE traversal
  # sink. The data file for THIS request is ALWAYS exactly $OUTBOX/$ID.data
  # (server-chosen id), so read+remove only that and ignore whatever path the
  # phone sent. (data_path is treated purely as a "uses a data file" flag.)
  DF="$OUTBOX/$ID.data"
  if [ -f "$DF" ]; then
    if [ "$CMD" = "audio" ]; then
      # Audio is BINARY and usually large. Dumping it to stdout would wedge the
      # agent's terminal and is useless to it anyway — what it wants is a path it
      # can hand to a transcriber. So move the payload into place and print that.
      AUDIO_OUT="${ARGS[out]:-$BRIDGE_DIR/audio-$(date +%Y%m%d-%H%M%S).m4a}"
      mkdir -p "$(dirname "$AUDIO_OUT")"
      mv "$DF" "$AUDIO_OUT"
      chmod 600 "$AUDIO_OUT"
      printf '%s
' "$AUDIO_OUT"
    else
      cat "$DF"
      rm -f "$DF"
    fi
  fi
else
  # Straight from the field to stdout: a command substitution would eat the
  # trailing newlines of whatever ran on the phone.
  kv_txt text
fi
[ -n "$META" ] && echo "[bridge] $META" >&2
rm -f "$RES" "$KV"
