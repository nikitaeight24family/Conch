<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SshAi" parent="android:Theme.Material.NoActionBar" />

    <!--
        Splash screen theme — applied as MainActivity's `android:theme`.
        `installSplashScreen()` in MainActivity.onCreate consumes it and
        swaps to `Theme.SshAi` for the actual UI. Without this redirect
        the launcher icon flashes a white "blank window" while
        ServiceLocator + Compose warm up.

        windowSplashScreenAnimatedIcon = the `>_` foreground vector,
        windowSplashScreenBackground   = near-black brand background.
        postSplashScreenTheme          = real app theme to swap into.
    -->
    <style name="Theme.SshAi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SshAi</item>
    </style>
</resources>
